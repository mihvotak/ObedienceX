<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObedienceX.Views.ExaminationsPage">
	<ContentPage.ToolbarItems>
		<ToolbarItem Text="{Binding SaveText}"
                     Clicked="OnSaveClicked" />
	</ContentPage.ToolbarItems>
	<Grid Padding="0,0,0,0" BackgroundColor="{StaticResource PageBackground}" VerticalOptions="FillAndExpand">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid Padding="10,10,10,0" Grid.Row="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="30" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="40" />
			</Grid.ColumnDefinitions>

			<Label Grid.Column="0"
					Text="№"
					Margin="3,0,0,0"
					FontSize="Medium"  
						   />
			<Label Grid.Column="1"
					Text="Испытание"
					Margin="3,0,0,0"
					FontSize="Medium"  
						   />
			<Label Grid.Column="2"
					Text="*К"
					Margin="3,0,0,0"
				   LineBreakMode="NoWrap"
					FontSize="Medium"  
							/>
		</Grid>
		<ScrollView VerticalScrollBarVisibility="Always" Grid.Row="1">
			<CollectionView x:Name="collectionView">
				<CollectionView.ItemsLayout>
					<GridItemsLayout Orientation="Vertical"/>
				</CollectionView.ItemsLayout>
				<!-- Define the appearance of each item in the list -->
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid Padding="10,0,10,10">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="40" />
							</Grid.ColumnDefinitions>

							<Label Grid.Column="0"
								   Text="{Binding Number}"
								   FontSize="Medium"
								   BackgroundColor="{StaticResource SubHeader}" 
								   VerticalTextAlignment="Center"
								   HorizontalTextAlignment="Center"
								/>
							<Entry Grid.Column="1"
								   Text="{Binding Name}"
								   FontSize="Large"
								   TextChanged="OnTextChanged"
							   />
							<Entry Grid.Column="2"
								   Text="{Binding Multiplier}"
								   Keyboard="Numeric"
								   FontSize="Large"
								   TextChanged="OnMultiplierChanged"
								   HorizontalTextAlignment="Center"
								/>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</ScrollView>
		<Grid RowDefinitions="*,*" ColumnDefinitions="*,*" Margin="5" Grid.Row="2" ColumnSpacing="2">
			<Label x:Name="SummaryLabel" Grid.ColumnSpan="2"
				Padding="0, 5" FontSize="Medium" />
			<Button Grid.Row="1" Grid.Column="0"
				Text="Добавить" Clicked="OnAddClicked" Padding="0, 5" FontSize="Medium"/>
			<Button Grid.Row="1" Grid.Column="1"
				Text="Уменьшить" Clicked="OnRemoveClicked" Padding="0, 5" FontSize="Medium" />
		</Grid>
	</Grid>
</ContentPage>
