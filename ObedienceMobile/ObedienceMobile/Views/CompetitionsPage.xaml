<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObedienceX.Views.CompetitionsPage"
			 Title="Открыть файл соревнований">

	<Grid BackgroundColor="{StaticResource PageBackground}" RowDefinitions="Auto,*,Auto">
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*" RowDefinitions="Auto, Auto, Auto" Margin="10, 10, 10, 0" ColumnSpacing="2">
			<Button Text="Корень /" Clicked="OnGoRootClick" Margin="0, 5" Padding="0, 10" />
			<Button Text="Выше ⬆" Clicked="OnGoUpClick" Grid.Column="1" Margin="0, 5" Padding="0, 10" />
			<Button Text="Загрузки ⤓" Clicked="OnGoDownloadClick" Grid.Column="2" Margin="0, 5" Padding="0, 10" />
			<Label x:Name="CurrentPath" Grid.ColumnSpan="3" Grid.Row="1"
				   Padding="5,0"
				   FontSize="Medium" VerticalTextAlignment="Center"
				   BackgroundColor="{StaticResource SubHeader}"/>
			<Label x:Name="Error" Grid.ColumnSpan="3" Grid.Row="2"
				   Padding="0,0" BackgroundColor="{StaticResource SubHeader}"
				   FontSize="Small" VerticalOptions="CenterAndExpand"
				   TextColor="Red" />
		</Grid>
		<ScrollView x:Name="MainScrollView" Grid.Row="1">
			<CollectionView x:Name="collectionView"
                    Margin="10"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="5" />
				</CollectionView.ItemsLayout>
				<!-- Define the appearance of each item in the list -->
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0" Padding="5" RowSpacing="1" ColumnSpacing="1" BackgroundColor="{StaticResource LabelBg}"
							  RowDefinitions="*,*" ColumnDefinitions="40,*">
							<Image Source="excel.png" Grid.RowSpan="2" BackgroundColor="{StaticResource SubHeader}"
								   IsVisible="{Binding IsExcel}"/>
							<Image Source="xls.png" Grid.RowSpan="2" BackgroundColor="{StaticResource SubHeader}"
								   IsVisible="{Binding IsXls}"/>
							<Image Source="folder.png" Grid.RowSpan="2" BackgroundColor="{StaticResource SubHeader}"
								   IsVisible="{Binding IsFolder}"/>
							<Label Text="{Binding ShortName}" Grid.Column="1"
								   Padding="5,5" BackgroundColor="{StaticResource SubHeader}"
								   TextColor="{StaticResource TextColor}"
								   FontSize="Medium"/>
							<Label Text="{Binding DateStr}" Grid.Row="1" Grid.Column="1"
								   Padding="5,0" BackgroundColor="{StaticResource SubHeader}"
								   FontSize="Small" />
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</ScrollView>
		<Button x:Name="OkButton" Grid.Row="2" Text="Выбрано" Clicked="OnOkClicked"
				Margin="10, 5, 10, 10"/>
	</Grid>
</ContentPage>
